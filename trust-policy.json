{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::590507089733:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": [
            "repo:Amish-kumar-08@358250174/project-18-gitops-infra-deployment@1469782395:pull_request",
            "repo:Amish-kumar-08@358250174/project-18-gitops-infra-deployment@1469782395:environment:production"
          ]
        }
      }
    }
  ]
}
